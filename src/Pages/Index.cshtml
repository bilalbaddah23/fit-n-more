@page
@{ViewData["Title"]="For your next move.";ViewData["Page"]="home";}
<section class="fashion-hero"><div class="fashion-hero-copy"><span class="eyebrow">STYLE · DUBAI / LEBANON</span><h1>Move your way.<br/><em>Style your day.</em></h1><p>An everyday set. A fresh pair. A little more energy. Explore the sportswear, sneakers and lifestyle looks shared by Fit N More.</p><a href="/shop" class="button">Explore the edit <span>↗</span></a><div class="hero-meta"><span>EXPLORE THE COLLECTION</span><span>A PERSONAL CONVERSATION</span></div></div><div class="fashion-hero-image"><img src="@Shop.Settings.Hero" alt="From the Fit N More collection" width="1080" height="1440" fetchpriority="high"/><span class="photo-label">THE FIT N MORE EDIT / 01</span></div><span class="hero-decoration" aria-hidden="true">✳</span></section>
<div class="values-strip"><span>For your next move.</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><a href="/lookbook">A closer look at the collection ↗</a></div>
<div class="n12-running" aria-hidden="true"><div><span>Fit N More</span><i>✦</i><span>STYLE · DUBAI / LEBANON</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i><span>Fit N More</span><i>✦</i><span>STYLE · DUBAI / LEBANON</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i><span>Fit N More</span><i>✦</i><span>STYLE · DUBAI / LEBANON</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i><span>Fit N More</span><i>✦</i><span>STYLE · DUBAI / LEBANON</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i></div></div>
<section class="section first-edit" data-reveal><div class="section-heading"><div><span class="eyebrow">FIND YOUR NEXT FAVOURITE</span><h2>Good looks.<br/><em>Your own way.</em></h2></div><div><p>A selection from the collection.<br/>Keep the looks you love close.</p><a href="/shop" class="text-link">Discover the whole edit ↗</a></div></div><div class="product-grid">@foreach(var p in Shop.Products.Take(4)){<partial name="_Card" model="p"/>}</div></section>
<section class="fashion-story" data-reveal><div class="fashion-story-photo"><img src="@Shop.Settings.Story" alt="A closer look at Fit N More" width="900" height="1200" loading="lazy"/></div><div class="fashion-story-copy"><span class="eyebrow">THE WORLD OF FIT N MORE</span><h2>The story.<br/><em>Your own way.</em></h2><p>Fit N More’s public profile lists Dubai/Lebanon, personal shopping and WhatsApp orders. Browse photographed sneaker and clothing examples, then confirm the exact reference, current availability, measurements and delivery details with the team.</p><a href="/our-world" class="button outline">Discover our world <span>↗</span></a><span class="section-number">02 / Fit N More</span></div></section>
<section class="section category-edit" data-reveal><div class="section-heading"><div><span class="eyebrow">A LITTLE DIRECTION</span><h2>What are you<br/><em>in the mood for?</em></h2></div><a href="/style-guide" class="text-link">Help me choose ↗</a></div><div class="category-grid">@foreach(var (category,i) in Shop.Products.Select(p=>p.Collection).Distinct().Take(3).Select((x,i)=>(x,i))){var p=Shop.Products.First(p=>p.Collection==category);<a href="/shop?collection=@Uri.EscapeDataString(category)"><div><img src="@p.Images[0]" alt="@category from Fit N More" width="700" height="930" loading="lazy"/></div><span>0@(i+1) / @category <b>↗</b></span></a>}</div></section>
<section class="section diary-feature" data-reveal><div><span class="eyebrow">THE VISUAL DIARY</span><h2>A detail.<br/>A different angle.<br/><em>A new favourite.</em></h2><p>Explore the collection in photographs. Follow a colour, discover a silhouette and gather your inspiration.</p><a href="/lookbook" class="button">Open the photo diary <span>↗</span></a></div><div class="diary-pair"><img src="@Shop.Products.Last().Images[0]" alt="Collection inspiration from Fit N More" width="720" height="960" loading="lazy"/><img src="@Shop.Products.Skip(1).First().Images.Last()" alt="More collection details from Fit N More" width="520" height="690" loading="lazy"/></div></section>
<section class="section shopping-steps" data-reveal><div><span class="eyebrow">MAKE IT PERSONAL</span><h2>From inspiration<br/><em>to a conversation.</em></h2></div><ol><li><span>01</span><h3>Find your favourites</h3><p>Browse the collection, explore the photographs and save the looks that speak to you.</p></li><li><span>02</span><h3>Build your selection</h3><p>Add your pieces to a bag and share your size, colour and delivery questions.</p></li><li><span>03</span><h3>Talk to the team</h3><p>Review your enquiry before sending. The boutique confirms options, availability and the final price.</p></li></ol></section>
